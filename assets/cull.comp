#version 460 core

struct Light {
    vec4 position;
    vec4 color;
    float radius;
    float strength;
    float linear;
    float quadratic;
};

struct Tile {
    uint count;
    uint offset;
};

layout(std430, binding = 0) buffer light_buffer {
    Light lights[];
};

layout(std430, binding = 1) buffer tile_buffer {
    Tile tiles[];
};

layout(std430, binding = 2) buffer tile_light_buffer {
    uint light_indices[];
};

layout(binding = 0) uniform sampler2D depth_texture;

uniform mat4 view;
uniform mat4 projection;
uniform vec2 screen_size;

uniform uint tiles_x;
uniform uint tiles_y;
uniform uint light_count;
uniform uint max_lights_per_tile;

layout(local_size_x = 16, local_size_y = 16) in;

shared float min_depths[256];
shared float max_depths[256];

void compute_tile_depth(uint tile_index) {
    uint local_index = gl_LocalInvocationIndex;

    uint tile_x = tile_index % tiles_x;
    uint tile_y = tile_index / tiles_x;

    // Pick a pixel inside this tile for this thread
    uint px = tile_x * 16 + gl_LocalInvocationID.x;
    uint py = tile_y * 16 + gl_LocalInvocationID.y;

    float depth = 1.0;

    if (px < uint(screen_size.x) && py < uint(screen_size.y))
    {
        depth = texelFetch(
            depth_texture,
            ivec2(px, py),
            0
        ).r;
    }

    min_depths[local_index] = depth;
    max_depths[local_index] = depth;

    barrier();

    // Parallel reduction
    for (uint stride = 128; stride > 0; stride >>= 1) {
        if (local_index < stride) {
            min_depths[local_index] = min(
                min_depths[local_index],
                min_depths[local_index + stride]
            );

            max_depths[local_index] = max(
                max_depths[local_index],
                max_depths[local_index + stride]
            );
        }

        barrier();
    }
}

vec3 tile_corner_world_position(uint tile_index, float depth, vec2 corner) {
    uint tile_x = tile_index % tiles_x;
    uint tile_y = tile_index / tiles_x;

    vec2 tile_size = screen_size / vec2(tiles_x, tiles_y);

    vec2 pixel = (vec2(tile_x, tile_y) + corner) * tile_size;

    vec2 ndc;
    ndc.x = pixel.x / screen_size.x * 2.0 - 1.0;
    ndc.y = pixel.y / screen_size.y * 2.0 - 1.0;

    float ndc_z = depth * 2.0 - 1.0;

    vec4 view_pos = inverse(projection) * vec4(ndc, ndc_z, 1.0);
    view_pos /= view_pos.w;

    return (inverse(view) * view_pos).xyz;
}

vec3 tile_world_position(uint tile_index, float depth) {
    uint tile_x = tile_index % tiles_x;
    uint tile_y = tile_index / tiles_x;

    // Pixel coordinate at center of tile
    vec2 pixel = (vec2(tile_x, tile_y) + 0.5) * (screen_size / vec2(tiles_x, tiles_y));

    // Convert screen pixel -> NDC
    vec2 ndc;
    ndc.x = (pixel.x / screen_size.x) * 2.0 - 1.0;
    ndc.y = (pixel.y / screen_size.y) * 2.0 - 1.0;

    // Depth buffer -> NDC Z
    float ndc_z = depth * 2.0 - 1.0;

    // Reconstruct view space position
    vec4 view_pos = inverse(projection) * vec4(ndc, ndc_z, 1.0);
    view_pos /= view_pos.w;

    // View -> world
    vec4 world_pos = inverse(view) * view_pos;

    return world_pos.xyz;
}

bool light_intersects_tile(uint tile_index, Light light) {
    float min_depth = min_depths[0];
    float max_depth = max_depths[0];

    vec3 corners[8];

    corners[0] = tile_corner_world_position(tile_index, min_depth, vec2(0,0));
    corners[1] = tile_corner_world_position(tile_index, min_depth, vec2(1,0));
    corners[2] = tile_corner_world_position(tile_index, min_depth, vec2(0,1));
    corners[3] = tile_corner_world_position(tile_index, min_depth, vec2(1,1));

    corners[4] = tile_corner_world_position(tile_index, max_depth, vec2(0,0));
    corners[5] = tile_corner_world_position(tile_index, max_depth, vec2(1,0));
    corners[6] = tile_corner_world_position(tile_index, max_depth, vec2(0,1));
    corners[7] = tile_corner_world_position(tile_index, max_depth, vec2(1,1));

    vec3 min_point = corners[0];
    vec3 max_point = corners[0];

    for (int i = 1; i < 8; i++) {
        min_point = min(min_point, corners[i]);
        max_point = max(max_point, corners[i]);
    }

    vec3 closest = clamp(
        light.position.xyz,
        min_point,
        max_point
    );

    return length(light.position.xyz - closest) <= light.radius;
}

void add_light_to_tile(uint tile_index, uint light_index) {
    uint index = atomicAdd(tiles[tile_index].count, 1);

    if (index < max_lights_per_tile) {
        light_indices[tiles[tile_index].offset + index] = light_index;
    }
    else {
        atomicMin(tiles[tile_index].count, max_lights_per_tile);
    }
}

void main() {
    uint tile_x = gl_GlobalInvocationID.x;
    uint tile_y = gl_GlobalInvocationID.y;

    if (tile_x >= tiles_x || tile_y >= tiles_y)
        return;

    uint tile_index = tile_y * tiles_x + tile_x;

    compute_tile_depth(tile_index);

    for (uint i = 0; i < light_count; i++) {
        if (light_intersects_tile(tile_index, lights[i])) {
            add_light_to_tile(tile_index, i);
        }
    }
}